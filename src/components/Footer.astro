---
const year = new Date().getFullYear();
---
<footer class="footer" id="contact">
  <div class="container">
    <div class="contact-section">
      <div class="status-indicator">
        <span class="pulse-dot"></span>
        <span>Open to full-time & high-impact contract opportunities</span>
      </div>
      <h2>Let's Build Something Great Together</h2>
      <p class="subtext">
        Whether you're looking for a Senior Gameplay Engineer to architect your next multiplayer title, need to optimize performance for VR/console hardware, or want to build intuitive tools for your design team—I'd love to connect.
      </p>

      <div class="contact-cards">
        <a href="mailto:hemalpatel2990@outlook.com" class="contact-card">
          <div class="card-icon">✉</div>
          <div class="card-info">
            <span class="card-label">Email</span>
            <span class="card-value">hemalpatel2990@outlook.com</span>
          </div>
        </a>

        <a href="tel:908-300-4557" class="contact-card">
          <div class="card-icon">📞</div>
          <div class="card-info">
            <span class="card-label">Phone</span>
            <span class="card-value">908-300-4557</span>
          </div>
        </a>

        <a href="https://linkedin.com/in/hemalpatel2990" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="card-icon">in</div>
          <div class="card-info">
            <span class="card-label">LinkedIn</span>
            <span class="card-value">linkedin.com/in/hemalpatel2990</span>
          </div>
        </a>

        <a href="https://github.com/hemalpatel2990" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="card-icon">git</div>
          <div class="card-info">
            <span class="card-label">GitHub</span>
            <span class="card-value">github.com/hemalpatel2990</span>
          </div>
        </a>

        <a href="https://youtube.com/@HemalPatel117" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="card-icon">▶</div>
          <div class="card-info">
            <span class="card-label">YouTube</span>
            <span class="card-value">@HemalPatel117</span>
          </div>
        </a>

        <a href="/Hemal-SeniorProgrammer-Resume.pdf" class="contact-card primary-card" download>
          <div class="card-icon">📄</div>
          <div class="card-info">
            <span class="card-label">Download</span>
            <span class="card-value">Resume PDF</span>
          </div>
        </a>
      </div>
    </div>
    
    <div class="bottom-bar">
      <p>&copy; {year} Hemal Patel &bull; Senior Gameplay & Systems Engineer</p>
      <div class="location">Based in Horsham, PA (Remote Available Worldwide)</div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: rgba(255, 255, 255, 0.015);
    border-top: 1px solid var(--border);
    padding: 80px 0 40px;
    margin-top: 100px;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .contact-section {
    text-align: center;
    margin-bottom: 60px;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #4ade80;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    padding: 5px 14px;
    border-radius: 999px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 6px #22c55e;
  }

  h2 {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    color: var(--text);
  }

  .subtext {
    color: #a3a3a3;
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto 40px;
  }

  .contact-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    text-align: left;
  }

  @media (max-width: 768px) {
    .contact-cards { grid-template-columns: 1fr; }
    h2 { font-size: 1.75rem; }
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    padding: 14px 18px;
    border-radius: 8px;
    text-decoration: none;
    transition: var(--transition);
  }

  .contact-card:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .primary-card {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
  }

  .primary-card:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: #60a5fa;
  }

  .card-icon {
    font-size: 1.1rem;
    font-weight: 800;
    color: #60a5fa;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
  }

  .card-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .card-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 700;
  }

  .card-value {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 30px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
    flex-wrap: wrap;
    gap: 12px;
  }

  .location {
    font-weight: 600;
    color: var(--text);
  }
</style>
