---
<section class="shipped" id="shipped">
  <div class="section-header">
    <div>
      <h2>Shipped Shows & Interactive Apps</h2>
      <span class="section-tagline">High-concurrency virtual concerts, XR platforms, and commercial titles</span>
    </div>
    <span class="hint-badge">Click cards to watch videos or visit stores</span>
  </div>

  <div class="grid">
    {titles.map(title => (
      <div 
        class={`title-card ${title.youtubeId ? 'has-video' : ''} ${title.storeUrl ? 'has-store' : ''}`} 
        data-video-id={title.youtubeId}
        data-store-url={title.storeUrl}
        role="button"
        tabindex="0"
        aria-label={`${title.name} (${title.company})`}
      >
        <div class="image-container">
          <img src={title.image} alt={title.name} loading="lazy" />
          
          <div class="type-badge">
            {title.youtubeId && <span class="play-indicator">▶</span>}
            {title.badge}
          </div>

          {title.youtubeId && (
            <div class="play-overlay">
              <div class="action-button">
                <svg viewBox="0 0 24 24" fill="currentColor" class="play-icon">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
          )}

          {title.storeUrl && !title.youtubeId && (
            <div class="play-overlay">
              <div class="action-button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="store-icon">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </div>
            </div>
          )}
        </div>

        <div class="hover-overlay">
          <p class="hover-title">{title.name}</p>
          <p class="contribution">{title.contribution}</p>
          <span class="hover-action">
            {title.youtubeId ? 'Click to Watch Video →' : title.storeUrl ? 'Click to Open Store →' : 'Shipped Commercial Title'}
          </span>
        </div>

        <div class="info">
          <h3>{title.name}</h3>
          <p class="platform-text">{title.platform} &bull; {title.year}</p>
          <span class="company">{title.company}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.title-card');

  cards.forEach(card => {
    const handleAction = () => {
      const videoId = card.getAttribute('data-video-id');
      const storeUrl = card.getAttribute('data-store-url');
      
      if (videoId) {
        window.dispatchEvent(new CustomEvent('play-video', {
          detail: { videoId }
        }));
      } else if (storeUrl) {
        window.open(storeUrl, '_blank', 'noopener,noreferrer');
      }
    };

    card.addEventListener('click', handleAction);
    card.addEventListener('keydown', (e) => {
      const keyEvent = e as KeyboardEvent;
      if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
        keyEvent.preventDefault();
        handleAction();
      }
    });
  });
</script>

<style>
  .shipped {
    margin: 0 0 100px;
    padding: 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 12px;
  }

  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    margin: 0;
    font-weight: 700;
  }

  .section-tagline {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
    display: block;
    margin-top: 4px;
  }

  .hint-badge {
    font-size: 0.75rem;
    color: #60a5fa;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 550px) {
    .grid { grid-template-columns: 1fr; }
  }

  .title-card {
    position: relative;
    transition: var(--transition);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    display: flex;
    flex-direction: column;
  }

  .title-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-4px);
  }

  .title-card.has-video,
  .title-card.has-store {
    cursor: pointer;
  }

  .image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 12px;
    border: 1px solid var(--border);
    background: #000;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .type-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 5;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 4px;
    letter-spacing: 0.02em;
  }

  .play-indicator {
    color: #60a5fa;
    font-size: 0.65rem;
  }

  .play-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: var(--transition);
  }

  .action-button {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(6px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: var(--transition);
  }

  .action-button svg {
    width: 20px;
    height: 20px;
  }

  .play-icon {
    margin-left: 2px;
  }

  .title-card:hover .image-container img {
    transform: scale(1.06);
  }

  .title-card:hover .action-button {
    background: #ffffff;
    color: #000000;
    transform: scale(1.1);
  }

  .hover-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 10, 0.96);
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    transition: var(--transition);
    z-index: 20;
    text-align: center;
    border-radius: 8px;
    border: 1px solid #60a5fa;
    pointer-events: none;
    transform: translateY(6px);
  }

  .title-card:hover .hover-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  :global(body.modal-open) .hover-overlay {
    display: none;
  }

  .hover-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 8px;
  }

  .contribution {
    color: #d4d4d4;
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0 0 12px;
    font-weight: 500;
  }

  .hover-action {
    font-size: 0.75rem;
    font-weight: 700;
    color: #60a5fa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .info {
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
  }

  .platform-text {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .company {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #a3a3a3;
  }
</style>
