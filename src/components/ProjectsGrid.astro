---
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
---
<section class="projects" id="projects">
  <div class="section-header">
    <div>
      <h2>Technical Projects & Unreal Engine Plugins</h2>
      <span class="section-tagline">Open-source gameplay frameworks, concurrency libraries, and designer tooling</span>
    </div>
  </div>

  <div class="grid">
    {sortedProjects.map(async (project) => {
      const { Content } = await project.render();
      return (
        <article class="project-card">
          {project.data.image && (
            <div class="image-container">
              <img src={project.data.image} alt={project.data.title} loading="lazy" />
            </div>
          )}
          <div class="card-content">
            <div class="card-top">
              <h3>{project.data.title}</h3>
              <div class="tech-stack">
                {project.data.tech.map(t => <span class="tech-pill">{t}</span>)}
              </div>
            </div>
            
            <div class="project-body">
              <Content />
            </div>

            {project.data.link && (
              <div class="card-footer">
                <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="project-link">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  <span>View Repository</span>
                  <span class="arrow">&rarr;</span>
                </a>
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .projects {
    margin: 0 0 100px;
    padding: 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 10px;
  }

  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    margin: 0;
    font-weight: 700;
  }

  .section-tagline {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
    display: block;
    margin-top: 4px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  @media (max-width: 850px) {
    .grid { grid-template-columns: 1fr; }
  }

  .project-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.04);
  }

  .image-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: #000;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .project-card:hover .image-container img {
    transform: scale(1.04);
  }

  .card-content {
    padding: 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card-top {
    margin-bottom: 16px;
  }

  h3 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-pill {
    font-size: 0.72rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
    padding: 3px 8px;
    border-radius: 4px;
    color: #93c5fd;
    font-weight: 600;
  }

  .project-body {
    color: #cccccc;
    line-height: 1.6;
    font-size: 0.92rem;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .project-body :global(p) {
    margin: 0 0 12px;
  }

  .project-body :global(ul) {
    margin: 0;
    padding-left: 18px;
    list-style-type: none;
  }

  .project-body :global(li) {
    margin-bottom: 8px;
    position: relative;
  }

  .project-body :global(li:last-child) {
    margin-bottom: 0;
  }

  .project-body :global(li::before) {
    content: "";
    position: absolute;
    left: -16px;
    top: 8px;
    width: 5px;
    height: 5px;
    background: #60a5fa;
    border-radius: 50%;
  }

  .card-footer {
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin-top: auto;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    gap: 8px;
    transition: var(--transition);
  }

  .project-link:hover {
    color: #60a5fa;
  }

  .project-link:hover .arrow {
    transform: translateX(4px);
  }

  .arrow {
    transition: var(--transition);
  }
</style>
