---
const skillCategories = [
  {
    name: "Engines",
    skills: ["Unreal Engine 4/5", "Unity", "Godot", "Defold", "Panda3D"]
  },
  {
    name: "Languages",
    skills: ["C++", "C#", "Python", "Lua"]
  },
  {
    name: "Gameplay Engineering",
    skills: [
      "GameMode / GameState / PlayerState",
      "Server-Authoritative Architecture",
      "Multiplayer Networking & Replication",
      "Gameplay Ability System (GAS / GMAS)",
      "Gameplay Systems",
      "Slate & UMG UI",
      "Multithreading (Task Graph)",
      "Performance Profiling & Optimization"
    ]
  },
  {
    name: "Tools & Pipeline",
    skills: [
      "Designer & Artist Editor Tools",
      "CI/CD Automation",
      "BuildGraph",
      "RenderDoc",
      "Unreal Insights",
      "Git & Perforce",
      "Docker & Linux",
      "JIRA"
    ]
  },
  {
    name: "Platforms",
    skills: [
      "PC (Windows, Linux)",
      "Meta Quest 3 (Standalone VR)",
      "Steam & Pico XR"
    ]
  },
  {
    name: "Online & Backend",
    skills: ["Meta XR SDKs", "PlayFab", "NATS", "REST APIs", "AWS", "Grafana"]
  },
  {
    name: "AI Workflow",
    skills: ["Agentic Tooling & Coding", "Local LLM Deployment", "Context Window Optimization"]
  }
];
---
<section class="skills-sidebar" id="skills">
  <h2>Technical Competencies</h2>
  <div class="categories">
    {skillCategories.map(category => (
      <div class="category">
        <h3>{category.name}</h3>
        <div class="tags">
          {category.skills.map(skill => (
            <span class="tag">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-sidebar {
    padding: 0;
  }
  h2 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 10px;
    margin-bottom: 25px;
  }
  .categories {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .category h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 10px;
    color: var(--text);
    font-weight: 700;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 4px 9px;
    border-radius: 4px;
    color: var(--text-muted);
    transition: var(--transition);
    font-weight: 500;
    line-height: 1.3;
  }
  .tag:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.3);
  }
</style>
