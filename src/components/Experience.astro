---
import { getCollection } from 'astro:content';
const exp = await getCollection('experience');
const primaryExp = exp.filter(item => item.data.category !== 'additional').sort((a, b) => a.data.order - b.data.order);
const additionalExp = exp.filter(item => item.data.category === 'additional').sort((a, b) => a.data.order - b.data.order);
---
<section class="experience" id="experience">
  <div class="section-header">
    <h2>Engineering Experience</h2>
    <span class="section-tagline">11+ years shipping production gameplay systems & engine tooling</span>
  </div>

  <div class="timeline">
    {primaryExp.map(async (item) => {
      const { Content } = await item.render();
      return (
        <article class="item">
          <div class="item-header">
            <div class="company-info">
              <h3>{item.data.company}</h3>
              <p class="role">{item.data.title}</p>
            </div>
            <div class="meta">
              <span class="date">{item.data.date}</span>
              <span class="location">{item.data.location}</span>
            </div>
          </div>

          {item.data.tags && item.data.tags.length > 0 && (
            <div class="role-tags">
              {item.data.tags.map((tag: string) => (
                <span class="role-tag">{tag}</span>
              ))}
            </div>
          )}

          <div class="content">
            <Content />
          </div>
        </article>
      );
    })}
  </div>

  {additionalExp.length > 0 && (
    <div class="additional-section">
      <div class="section-header">
        <h2 class="sub-section-title">Additional Experience & Contributions</h2>
      </div>
      <div class="timeline">
        {additionalExp.map(async (item) => {
          const { Content } = await item.render();
          return (
            <article class="item">
              <div class="item-header">
                <div class="company-info">
                  <h3>{item.data.company}</h3>
                  <p class="role">{item.data.title}</p>
                </div>
                <div class="meta">
                  <span class="date">{item.data.date}</span>
                  <span class="location">{item.data.location}</span>
                </div>
              </div>

              {item.data.tags && item.data.tags.length > 0 && (
                <div class="role-tags">
                  {item.data.tags.map((tag: string) => (
                    <span class="role-tag">{tag}</span>
                  ))}
                </div>
              )}

              <div class="content">
                <Content />
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )}
</section>

<style>
  .experience {
    margin: 0 0 100px;
    padding: 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    margin-bottom: 50px;
    flex-wrap: wrap;
    gap: 10px;
  }

  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    margin: 0;
    font-weight: 700;
  }

  .section-tagline {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .item {
    position: relative;
    padding: 24px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: var(--transition);
  }

  .item:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.035);
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .role {
    color: #60a5fa; /* Soft electric blue */
    font-weight: 600;
    font-size: 1.05rem;
    margin: 4px 0 0;
  }

  .meta {
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .date {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
    padding: 3px 10px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .location {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .role-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .role-tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: #d4d4d4;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.2);
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  .content {
    color: #cccccc;
    line-height: 1.65;
    font-size: 0.95rem;
  }

  .content :global(ul) {
    margin: 0;
    padding-left: 18px;
    list-style-type: none;
  }

  .content :global(li) {
    margin-bottom: 10px;
    position: relative;
  }

  .content :global(li:last-child) {
    margin-bottom: 0;
  }

  .content :global(li::before) {
    content: "";
    position: absolute;
    left: -18px;
    top: 9px;
    width: 6px;
    height: 6px;
    background: #60a5fa;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(96, 165, 250, 0.6);
  }

  .additional-section {
    margin-top: 80px;
  }

  .sub-section-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    border: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .item-header { flex-direction: column; gap: 8px; }
    .meta { text-align: left; align-items: flex-start; }
    h3 { font-size: 1.35rem; }
    .item { padding: 18px; }
  }
</style>
