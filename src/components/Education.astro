---
const education = [
  {
    degree: "Master of Science in Computer Game Programming",
    institution: "DePaul University",
    details: "Coursework Completed &bull; Focus on Advanced Graphics, Engine Architecture & C++"
  },
  {
    degree: "Master of Business Administration (MBA)",
    institution: "CEPT University",
    details: "Information Technology & Project Management"
  },
  {
    degree: "Bachelor of Technology in Information Technology",
    institution: "Gujarat Technological University",
    details: "Foundations in Data Structures, Algorithms & Computer Systems"
  }
];
---
<section class="education" id="education">
  <div class="section-header">
    <h2>Education & Academic Background</h2>
  </div>
  <div class="grid">
    {education.map(item => (
      <div class="edu-card">
        <h3>{item.degree}</h3>
        <p class="institution">{item.institution}</p>
        {item.details && <p class="details" set:html={item.details} />}
      </div>
    ))}
  </div>
</section>

<style>
  .education {
    margin: 0 0 100px;
    padding: 0;
  }

  .section-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    margin-bottom: 35px;
  }

  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    margin: 0;
    font-weight: 700;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .edu-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px 24px;
    transition: var(--transition);
  }

  .edu-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.035);
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }

  .institution {
    color: #60a5fa;
    font-weight: 600;
    font-size: 0.95rem;
    margin: 5px 0 6px;
  }

  .details {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0;
    line-height: 1.5;
  }
</style>
