---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import ShippedTitles from '../components/ShippedTitles.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Hemal Patel | Senior Gameplay & Systems Engineer (UE5 / C++)">
  <Navigation />
  <main>
    <Hero />
    
    <div class="content-layout">
      <div class="main-content">
        <Experience />
        <ShippedTitles />
        <ProjectsGrid />
        <Education />
      </div>
      <aside class="sidebar">
        <div class="sticky-content">
          <div class="recruiter-quick-card">
            <div class="card-badge">Recruiter Snapshot</div>
            <ul class="quick-facts">
              <li>
                <span class="fact-title">Current Role</span>
                <span class="fact-val">Senior Gameplay Engineer</span>
              </li>
              <li>
                <span class="fact-title">Core Stack</span>
                <span class="fact-val">Unreal Engine 5 &bull; C++ &bull; Unity</span>
              </li>
              <li>
                <span class="fact-title">Specialization</span>
                <span class="fact-val">Multiplayer & Tooling</span>
              </li>
              <li>
                <span class="fact-title">Location</span>
                <span class="fact-val">Horsham, PA (Remote)</span>
              </li>
            </ul>
            <a href="/Hemal-SeniorProgrammer-Resume.pdf" class="quick-dl-btn" download>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download Full Resume</span>
            </a>
          </div>

          <Skills />
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .content-layout {
    max-width: 100%;
    margin: 40px auto 0;
    display: grid;
    grid-template-columns: 1fr 880px 360px 1fr;
    gap: 0;
  }

  .main-content {
    grid-column: 2;
    width: 100%;
    padding: 0 30px;
  }

  .sidebar {
    grid-column: 3;
    padding-left: 40px;
    width: 360px;
  }

  .sticky-content {
    position: sticky;
    top: 75px;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 35px;
  }

  .recruiter-quick-card {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    position: relative;
  }

  .card-badge {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #60a5fa;
    font-weight: 700;
    margin-bottom: 15px;
    display: inline-block;
  }

  .quick-facts {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .quick-facts li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fact-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .fact-val {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }

  .quick-dl-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: var(--transition);
    width: 100%;
  }

  .quick-dl-btn:hover {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    transform: translateY(-2px);
  }

  @media (max-width: 1400px) {
    .content-layout {
      grid-template-columns: 1fr 780px 320px 1fr;
    }
    .main-content {
      padding: 0 20px;
    }
    .sidebar {
      padding-left: 25px;
      width: 320px;
    }
    .sticky-content {
      width: 295px;
    }
  }

  @media (max-width: 1150px) {
    .content-layout {
      display: block;
      max-width: 820px;
      margin: 40px auto 0;
      padding: 0 20px;
    }
    .main-content {
      padding: 0;
    }
    .sidebar {
      width: 100%;
      padding-left: 0;
      margin-top: 60px;
    }
    .sticky-content {
      position: static;
      width: 100%;
    }
  }
</style>
